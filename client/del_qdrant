#!/usr/bin/env python3

import os
from qdrant_client import QdrantClient
from qdrant_client.models import Filter, MatchAny, MatchValue

def deleteq(choice):
    client = QdrantClient(host="localhost", port=6333)

    # Method 1: Delete all points (simpler approach)
    if choice.lower() == 'y':
        try:
            print("Deleting qdrant database...")
            # Delete all points from all collections
            collections = client.get_collections()
            for collection in collections.collections:
                collection_name = collection.name
                print(f"Deleting all points from collection: {collection_name}")
                client.delete_collection(collection_name)
                # Recreate the collection (optional, depending on your needs)
                client.recreate_collection(
                    collection_name=collection_name,
                    vectors_config={"size": 1536, "distance": "Cosine"}  # Adjust based on your vector size
                )
            print("Database cleared successfully!")
        except Exception as e:
            print(f"Error: {e}")
    else:
        print("Operation cancelled.")

def main():
    choice = input("Type 'Y' to delete qdrant database, anything else to cancel: ")
    deleteq(choice)

if __name__ == "__main__":
    main()